# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (get from @userinfobot). The bot ignores everyone else.
OWNER_TELEGRAM_ID=123456789

# Google Service Account — share the spreadsheet with this email as Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# (Optional) Spreadsheet ID. Defaults to the «Расходы/доходы» v2 sheet — use a copy for development.
# SPREADSHEET_ID=

# OpenRouter — AI parsing of text and images
OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_MODEL=google/gemini-3.7-flash

# Groq — voice transcription
GROQ_API_KEY=gsk_your_key
# GROQ_STT_MODEL=whisper-large-v3-turbo

# (Optional) Time zone for "today"/"yesterday"
# BOT_TIMEZONE=Europe/Moscow

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
