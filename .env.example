# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Google Sheets ID (from the URL: https://docs.google.com/spreadsheets/d/{THIS_ID}/edit)
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# Google Service Account credentials
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Your Telegram user ID (get from @userinfobot)
ALLOWED_USER_ID=123456789

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
