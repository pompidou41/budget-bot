# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Google Service Account credentials
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Users share their Google Sheet with this email to give the bot access
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# (Optional) Your Telegram user ID for admin features (get from @userinfobot)
# ADMIN_USER_ID=123456789

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
